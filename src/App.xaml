<?xml version="1.0" encoding="utf-8"?>
<!-- File: App.xaml -->
<Application
    x:Class="SystemOptimizer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <!-- Colour palette. Dark is the 2.0 default; ThemeManager swaps this entry
                 at runtime for Palette.Light.xaml. Must come first so Native.xaml's
                 DynamicResource lookups resolve against it. -->
            <ResourceDictionary Source="Themes/Palette.Dark.xaml"/>
            <!-- Structure only, no colours. Windows convert onto this one at a time;
                 the Green/Blue rounded button styles below remain solely for the
                 dialogs not yet converted. -->
            <ResourceDictionary Source="Themes/Native.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <!-- Overlay Window Icons Font -->
        <FontFamily x:Key="MaterialIcons">
            pack://application:,,,/SystemOptimizer;component/MaterialIcons-Regular.ttf#Material Icons
        </FontFamily>
        <!-- Green Rounded Button Style -->
        <Style x:Key="GreenRoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="LimeGreen"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="White"
                            BorderThickness="2"
                            CornerRadius="12">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
        </Style>
        <!-- Blue Rounded Button Style -->
        <Style x:Key="BlueRoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#5BC0F7"/>
            <Setter Property="BorderBrush" Value="#1480AF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="#22243A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"
                                      ContentSource="Content"
                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A6E7FA"/>
                    <Setter Property="Foreground" Value="#121212"/>
                    <Setter Property="BorderBrush" Value="#3077A6"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#B0B0B0"/>
                    <Setter Property="Foreground" Value="#787878"/>
                    <Setter Property="BorderBrush" Value="#B0B0B0"/>
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- The global ToolTip style (dark #282B38, 16pt bold, 22,16 padding, drop
             shadow, OverridesDefaultStyle) was removed in 2.0. Tooltips are now the
             standard Windows ones: they follow OS theme, respect the user's font
             scaling, and size themselves to their content. -->
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="380"/>
        </Style>
      </ResourceDictionary>
    </Application.Resources>
</Application>
