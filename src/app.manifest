<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

  <!--
    Folded into SystemOptimizer.csproj (<ApplicationManifest>).

    An earlier version of this file was NOT applied - the csproj line that
    referenced it was commented out - so it never took effect. That was
    fortunate, because it requested `highestAvailable`, which forces a UAC
    prompt on every single launch. Program.Main is explicit that there is
    deliberately no auto-elevation ("Environment / elevation detection (NO
    auto-elevation)"), and UacHelper re-launches elevated only when a cleanup
    genuinely needs it. `asInvoker` is what the product has always actually
    done; it is now stated rather than left to a default.

    The stale <assemblyIdentity> block is gone too: it claimed version 1.1.0.16
    against the shipped product.

    DPI: WPF on .NET is per-monitor v2 aware, unlike WPF on Framework 4.7.2,
    which was system-DPI aware unless opted in. Declaring it here makes the
    change deliberate and visible rather than an accident of the runtime swap.
    It matters most for the overlay, which is a floating always-on-top HUD that
    users drag between monitors.
  -->

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">permonitorv2,permonitor</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>

</assembly>
