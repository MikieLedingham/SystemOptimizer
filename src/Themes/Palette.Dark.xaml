<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Dark palette - the 2.0 default.

        Colours live ONLY in palette dictionaries. Themes/Native.xaml holds structure
        (metrics, templates, typography) and references these keys via DynamicResource,
        so swapping this dictionary for Palette.Light.xaml re-themes the app live.
        Never put a literal colour anywhere else.
    -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#262626"/>
    <SolidColorBrush x:Key="SurfaceBrush"          Color="#1A1A1A"/>

    <SolidColorBrush x:Key="ControlBrush"          Color="#333333"/>
    <SolidColorBrush x:Key="ControlHoverBrush"     Color="#3D3D3D"/>
    <SolidColorBrush x:Key="ControlPressedBrush"   Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ControlBorderBrush"    Color="#454545"/>
    <SolidColorBrush x:Key="ControlDisabledBrush"  Color="#2A2A2A"/>

    <SolidColorBrush x:Key="TextPrimaryBrush"      Color="#F0F0F0"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"    Color="#9AA0A6"/>
    <SolidColorBrush x:Key="TextDisabledBrush"     Color="#6B6B6B"/>

    <SolidColorBrush x:Key="AccentBrush"           Color="#2F7FE0"/>
    <SolidColorBrush x:Key="AccentHoverBrush"      Color="#4A92E8"/>
    <SolidColorBrush x:Key="AccentPressedBrush"    Color="#2569BC"/>
    <SolidColorBrush x:Key="AccentTextBrush"       Color="#FFFFFF"/>

    <!-- Status colours, tuned to stay legible on the dark surface. -->
    <SolidColorBrush x:Key="ErrorBrush"             Color="#F27272"/>
    <SolidColorBrush x:Key="SuccessBrush"           Color="#6FCF7F"/>
    <SolidColorBrush x:Key="WarningBrush"           Color="#E8B750"/>

    <SolidColorBrush x:Key="SeparatorBrush"        Color="#3A3A3A"/>
    <SolidColorBrush x:Key="MenuBackgroundBrush"   Color="#2B2B2B"/>
    <SolidColorBrush x:Key="MenuHoverBrush"        Color="#3D3D3D"/>

</ResourceDictionary>
