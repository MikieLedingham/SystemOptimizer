<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light palette. Same keys as Palette.Dark.xaml - if you add a key here, add it
        there too, or a theme switch will throw a missing-resource exception at runtime.
    -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush"          Color="#F2F2F2"/>

    <SolidColorBrush x:Key="ControlBrush"          Color="#FBFBFB"/>
    <SolidColorBrush x:Key="ControlHoverBrush"     Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ControlPressedBrush"   Color="#E4E4E4"/>
    <SolidColorBrush x:Key="ControlBorderBrush"    Color="#D2D2D2"/>
    <SolidColorBrush x:Key="ControlDisabledBrush"  Color="#F5F5F5"/>

    <SolidColorBrush x:Key="TextPrimaryBrush"      Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"    Color="#5F6368"/>
    <SolidColorBrush x:Key="TextDisabledBrush"     Color="#A6A6A6"/>

    <SolidColorBrush x:Key="AccentBrush"           Color="#2F7FE0"/>
    <SolidColorBrush x:Key="AccentHoverBrush"      Color="#1E6ACB"/>
    <SolidColorBrush x:Key="AccentPressedBrush"    Color="#17539E"/>
    <SolidColorBrush x:Key="AccentTextBrush"       Color="#FFFFFF"/>

    <!-- Status colours. Same keys as Palette.Dark.xaml, darkened for a light surface. -->
    <SolidColorBrush x:Key="ErrorBrush"             Color="#C42B1C"/>
    <SolidColorBrush x:Key="SuccessBrush"           Color="#0F7B27"/>
    <SolidColorBrush x:Key="WarningBrush"           Color="#8A5A00"/>

    <SolidColorBrush x:Key="SeparatorBrush"        Color="#E2E2E2"/>
    <SolidColorBrush x:Key="MenuBackgroundBrush"   Color="#FBFBFB"/>
    <SolidColorBrush x:Key="MenuHoverBrush"        Color="#EDEDED"/>

</ResourceDictionary>
