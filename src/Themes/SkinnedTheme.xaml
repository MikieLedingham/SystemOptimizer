<!-- File: Themes/SkinnedTheme.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Global Font -->
    <FontFamily x:Key="AppFont">Segoe UI</FontFamily>

    <!-- Main window background color -->
    <SolidColorBrush x:Key="MainWindowBackground" Color="#FFE2F0F9"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="#FF37A8F9"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="White"/>

    <!-- Button Style (rounded, colored) -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="#6645A9FF"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            CornerRadius="18">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- You can add more styles for TextBlock, Labels, Windows, etc. -->

</ResourceDictionary>
