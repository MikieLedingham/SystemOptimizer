<!-- File: Dialogs/SanityCheckOptionsDialog.xaml -->
<Window x:Class="SystemOptimizer.Dialogs.SanityCheckOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Which checks run"
        Width="600" Height="520"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource AppFont}">

    <DockPanel Margin="{StaticResource PagePadding}">

        <TextBlock DockPanel.Dock="Top"
                   Text="Not every check suits every PC. Untick anything you do not care about and it will not run."
                   Style="{StaticResource LabelTextStyle}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4"/>

        <!-- Says what the ticks add up to, because a page of checkboxes does not.
             Also the place a check that was switched off BY DISMISSING IT TWICE becomes
             visible - otherwise the user has silenced something and has no way to find
             out that they did. -->
        <TextBlock x:Name="SummaryText"
                   DockPanel.Dock="Top"
                   Style="{StaticResource LabelTextStyle}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left"
                       Style="{StaticResource LabelTextStyle}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="0,0,16,0"
                       Text="Changes are saved as you make them."/>
            <Button x:Name="ResetButton"
                    Content="Reset to defaults"
                    Width="140"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Reset_Click"/>
            <Button Content="Close" Width="90" IsCancel="True" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="CloseButton_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ChecksPanel"/>
        </ScrollViewer>

    </DockPanel>
</Window>
