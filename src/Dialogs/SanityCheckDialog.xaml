<!-- File: Dialogs/SanityCheckDialog.xaml -->
<Window x:Class="SystemOptimizer.Dialogs.SanityCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sanity Check"
        Width="660" Height="560"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource AppFont}">

    <DockPanel Margin="{StaticResource PagePadding}">

        <!-- The headline is the first thing read and it must say something either way.
             "Nothing odd found" is a result; an empty window is not, and if silence and
             breakage look identical the feature has already failed. That is the direct
             lesson of the session this whole thing came from, where every indicator was
             green while four separate things were badly wrong. -->
        <TextBlock x:Name="HeadlineText"
                   DockPanel.Dock="Top"
                   Style="{StaticResource BodyTextStyle}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4"/>

        <TextBlock x:Name="SubText"
                   DockPanel.Dock="Top"
                   Style="{StaticResource LabelTextStyle}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="GuideLink"
                       Style="{StaticResource LabelTextStyle}"
                       Foreground="{DynamicResource AccentBrush}"
                       TextDecorations="Underline"
                       Cursor="Hand"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"
                       Text="Read about all the checks"
                       MouseLeftButtonUp="GuideLink_Click"/>
            <Button x:Name="ChooseChecksButton"
                    Content="Which checks run..."
                    Padding="12,0"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="ChooseChecks_Click"
                    ToolTip="Turn individual checks on or off for this PC."/>
            <Button x:Name="RunAgainButton"
                    Content="Check again"
                    Width="110"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="RunAgain_Click"/>
            <Button Content="Close" Width="90" IsCancel="True" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="CloseButton_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ResultsPanel"/>
        </ScrollViewer>

    </DockPanel>
</Window>
