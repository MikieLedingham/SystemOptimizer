<!-- File: RamOptionsDialog.xaml -->
<Window x:Class="SystemOptimizer.Dialogs.RamOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RAM options"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource AppFont}">

    <!-- 2.0: was a 460x640 chromeless window with Images/Clipboard.2.png as an
         ImageBrush and content pinned by a 114,196,76,134 margin. The threshold
         percentage was also rendered twice, by two identical bindings side by side. -->

    <StackPanel Margin="{StaticResource PagePadding}">

        <Border Style="{StaticResource StatPanelStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Free RAM" Style="{StaticResource LabelTextStyle}"/>
                <TextBlock x:Name="RamTextBlock" Text="--"
                           Style="{StaticResource StatValueTextStyle}"/>
            </StackPanel>
        </Border>

        <CheckBox x:Name="BoostRamCheckbox"   Content="Boost RAM now"
                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
        <CheckBox x:Name="AutoRamCheckbox"    Content="Enable automatic RAM cleanup"
                  Checked="AutoRam_Changed" Unchecked="Setting_Changed"/>

        <!-- Says whether automatic boosting is being held off right now. Switching auto-RAM
             on is the other moment that matters - it is the only place it is enabled - so
             the answer is given here as well as when no-boost mode itself is toggled. -->
        <TextBlock x:Name="BlockedNote"
                   Style="{StaticResource LabelTextStyle}"
                   Foreground="{DynamicResource WarningBrush}"
                   TextWrapping="Wrap"
                   Margin="24,2,0,0"
                   Visibility="Collapsed"/>

        <Button x:Name="ManageNoBoostButton"
                Content="Edit no-boost list..."
                Style="{StaticResource SecondaryButtonStyle}"
                Margin="0,8,0,0"
                ToolTip="Choose which apps and games pause automatic RAM boosting while they are running."
                Click="ManageNoBoostButton_Click"
                IsEnabled="{Binding IsChecked, ElementName=AutoRamCheckbox}"/>

        <TextBlock x:Name="RamThresholdLabel"
                   Text="Automatic cleanup threshold"
                   Style="{StaticResource LabelTextStyle}"
                   Margin="0,14,0,4"/>

        <DockPanel>
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding Value, ElementName=RamThresholdSlider, StringFormat={}{0:F0}%}"
                       Style="{StaticResource BodyTextStyle}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Width="42"
                       TextAlignment="Right"/>
            <Slider x:Name="RamThresholdSlider"
                    Minimum="25" Maximum="95"
                    TickFrequency="5"
                    IsSnapToTickEnabled="True"
                    TickPlacement="None"
                    VerticalAlignment="Center"
                    ValueChanged="Threshold_Changed"
                    ToolTip="When memory use passes this level, System Optimizer cleans memory automatically. It checks once a minute. Higher values mean less frequent cleaning; 80% or above suits most people."/>
        </DockPanel>

        <!-- "Remember these choices" and OK are gone, and this one was not merely inert
             like the no-boost list's: with Remember unticked, OK called
             ClearRamPreferences and actively RESET AutoRam, BoostRam and the threshold.
             Turning automatic cleanup on and pressing OK switched it back off. -->
        <TextBlock Text="Changes are saved as you make them."
                   Style="{StaticResource LabelTextStyle}"
                   Margin="0,12,0,0"/>

        <DockPanel Margin="0,14,0,0" LastChildFill="False">
            <!-- Resets the three settings this page owns: Boost RAM now, automatic
                 cleanup, and the threshold.
                 It does NOT touch LastBoostMessage, LastBoostTimeUtc, LastBoostAutomatic
                 or AutoTriggerCount. Those are a record of what happened, not a choice
                 anyone made, and the old "Clear all saved choices" replaced the entire RAM
                 section - so clearing cleanup selections also switched automatic boosting
                 off and threw the last result away. -->
            <Button x:Name="ClearSavedButton"
                    DockPanel.Dock="Left"
                    Content="Clear saved choices"
                    Padding="12,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="ClearSaved_Click"
                    ToolTip="Reset this page to its defaults. Your boost history is kept."/>
            <Button x:Name="CloseButton"
                    DockPanel.Dock="Right"
                    Content="Close"
                    Width="90"
                    IsDefault="True" IsCancel="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="CloseButton_Click"/>
        </DockPanel>

    </StackPanel>
</Window>
