<!-- File: Dialogs/LicenceWindow.xaml -->
<Window x:Class="SystemOptimizer.Dialogs.LicenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Licence"
        Width="660" Height="560"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource AppFont}">

    <DockPanel Margin="{StaticResource PagePadding}">

        <TextBlock DockPanel.Dock="Top"
                   Text="The terms this software is released under, and the components it uses. Shown from the program's own copy, so it is readable with no internet connection."
                   Style="{StaticResource LabelTextStyle}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CopyButton"
                    Content="Copy"
                    Width="90"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Copy_Click"
                    ToolTip="Copies the full text to the clipboard."/>
            <Button Content="Close" Width="90" IsCancel="True" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="CloseButton_Click"/>
        </StackPanel>

        <Border Background="{DynamicResource SurfaceBrush}"
                CornerRadius="{StaticResource CardCorner}"
                Padding="2">
            <!-- A read-only TextBox rather than a TextBlock: licence text is the one thing
                 in this application a user may genuinely need to select and copy, and a
                 TextBlock cannot be selected with the keyboard. Borderless and transparent
                 so it reads as a document rather than as a field to type in. -->
            <TextBox x:Name="LicenceText"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontFamily="Consolas"
                     FontSize="12"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Padding="10"/>
        </Border>

    </DockPanel>
</Window>
