<!-- File: Dialogs/RestoreDialog.xaml -->
<Window x:Class="SystemOptimizer.Dialogs.RestoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore a previous clean"
        Width="640" Height="480"
        MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource AppFont}">

    <DockPanel Margin="{StaticResource PagePadding}">

        <TextBlock DockPanel.Dock="Top"
                   Text="Every cleanup goes to the Recycle Bin, so any of these can be put back. Pick a run to see what it removed."
                   Style="{StaticResource LabelTextStyle}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="ResultText"
                       Style="{StaticResource LabelTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"
                       Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Width="90" IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        Click="CloseButton_Click"/>
                <Button x:Name="RestoreButton"
                        Content="Put these back"
                        Width="140"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="RestoreButton_Click"/>
            </StackPanel>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="SessionList"
                     Grid.Column="0"
                     SelectionChanged="SessionList_SelectionChanged"/>

            <Border Grid.Column="1"
                    Margin="12,0,0,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCorner}"
                    Padding="12,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DetailText"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Select a cleanup on the left."/>
                </ScrollViewer>
            </Border>
        </Grid>

    </DockPanel>
</Window>
