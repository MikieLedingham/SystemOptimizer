<Window x:Class="SystemOptimizer.AdminToolsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced admin tools"
        Width="374" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource AppFont}">

    <!-- 2.0: had default chrome but no theming, and was never registered in the csproj
         so it had never been compiled. Note it covers the same ground as
         AdminCleanupDialog - worth deciding whether both should exist. -->

    <StackPanel Margin="{StaticResource PagePadding}">

        <TextBlock Text="Administrator-only cleanup targets."
                   Style="{StaticResource LabelTextStyle}"
                   Margin="0,0,0,10"/>

        <Border Background="{DynamicResource SurfaceBrush}"
                CornerRadius="{StaticResource CardCorner}"
                Padding="12,10">
            <StackPanel>
                <CheckBox x:Name="WindowsTempCheckBox"    Content="Windows temp"/>
                <CheckBox x:Name="CrashDumpsCheckBox"     Content="Crash dumps"/>
                <CheckBox x:Name="OldWindowsCheckBox"     Content="Old Windows installation"/>
                <CheckBox x:Name="RecycleBinCheckBox"     Content="Empty Recycle Bin (permanent - cannot be undone)"/>
                <!-- "DNS cache" and "Thumbnail cache" removed with the same move that took
                     them off Admin cleanup: neither needs elevation, so neither belongs on
                     a page whose whole premise is that it does. Leaving them here would
                     also have re-created the second writer of Admin.DNSCache that the move
                     was meant to eliminate - this dialog persists what it runs. -->
            </StackPanel>
        </Border>

        <TextBlock x:Name="ElevationNotice"
                   Text="Not running as administrator - these actions will be refused."
                   Style="{StaticResource LabelTextStyle}"
                   Foreground="{DynamicResource WarningBrush}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,10,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Close"
                    Width="90"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"
                    Click="Close_Click"/>
            <Button Content="Run now"
                    Width="100"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="RunNow_Click"
                    ToolTip="Run the ticked actions immediately."/>
        </StackPanel>

    </StackPanel>
</Window>
